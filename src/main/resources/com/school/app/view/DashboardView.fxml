<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.app.controller.DashboardController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Text text="Tableau de Bord Administrateur" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
    
    <FlowPane hgap="20" vgap="20">
        <!-- Stats Cards -->
        <VBox alignment="CENTER" prefWidth="200" prefHeight="120" style="-fx-background-color: #3498db; -fx-background-radius: 10;">
            <Text text="Élèves" style="-fx-fill: white; -fx-font-size: 18px;"/>
            <Label fx:id="studentCount" text="0" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
        </VBox>
        
        <VBox alignment="CENTER" prefWidth="200" prefHeight="120" style="-fx-background-color: #2ecc71; -fx-background-radius: 10;">
            <Text text="Enseignants" style="-fx-fill: white; -fx-font-size: 18px;"/>
            <Label fx:id="teacherCount" text="0" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
        </VBox>
        
        <VBox alignment="CENTER" prefWidth="200" prefHeight="120" style="-fx-background-color: #e67e22; -fx-background-radius: 10;">
            <Text text="Classes" style="-fx-fill: white; -fx-font-size: 18px;"/>
            <Label fx:id="classCount" text="0" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
        </VBox>
    </FlowPane>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Text text="Inscriptions Récentes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <TableView fx:id="recentTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="eleveCol" text="Élève" prefWidth="200"/>
                <TableColumn fx:id="niveauCol" text="Niveau" prefWidth="150"/>
                <TableColumn fx:id="anneeCol" text="Année Scolaire" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
