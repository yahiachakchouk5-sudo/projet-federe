<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.app.controller.EleveController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Fiches Élèves" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="10">
        <TextField fx:id="nomField" promptText="Nom"/>
        <TextField fx:id="prenomField" promptText="Prénom"/>
        <DatePicker fx:id="datePicker" promptText="Date de Naissance"/>
        <Button text="Ajouter" onAction="#handleAddEleve" style="-fx-background-color: #27ae60;"/>
        <Button text="Modifier" onAction="#handleUpdateEleve" style="-fx-background-color: #2980b9;"/>
        <Button text="Supprimer" onAction="#handleDeleteEleve" style="-fx-background-color: #c0392b;"/>
    </HBox>

    <TableView fx:id="eleveTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="150"/>
            <TableColumn fx:id="dateCol" text="Date de Naissance" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
