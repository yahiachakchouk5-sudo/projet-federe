<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="@style.css" styleClass="login-container" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.app.controller.LoginController">
    <VBox spacing="20" alignment="CENTER" maxWidth="400" maxHeight="350" styleClass="login-box">
        <Text text="Connexion" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
        
        <VBox spacing="5">
            <Label text="Nom d'utilisateur" />
            <TextField fx:id="usernameField" promptText="Entrez votre nom d'utilisateur"/>
        </VBox>
        
        <VBox spacing="5">
            <Label text="Mot de passe" />
            <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe"/>
        </VBox>
        
        <Button text="Se Connecter" onAction="#handleLogin" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
        
        <Hyperlink text="Créer un compte" onAction="#handleGoToRegister" style="-fx-text-fill: #2c3e50;"/>
        
        <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>
    </VBox>
</StackPane>
