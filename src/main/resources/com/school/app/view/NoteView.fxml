<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.app.controller.NoteController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Saisie des Notes trimestrielles" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="classeCombo" promptText="Choisir Classe"/>
        <ComboBox fx:id="matiereCombo" promptText="Choisir Matière"/>
        <ComboBox fx:id="trimestreCombo" promptText="Trimestre"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="inscriptionCombo" promptText="Choisir Élève"/>
        <TextField fx:id="valeurField" promptText="Note (0-20)"/>
        <Button text="Enregistrer Note" onAction="#handleSaveNote" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Vider" onAction="#handleClear" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="noteTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="eleveCol" text="Élève" prefWidth="150"/>
            <TableColumn fx:id="matiereCol" text="Matière" prefWidth="150"/>
            <TableColumn fx:id="noteCol" text="Valeur" prefWidth="70"/>
            <TableColumn fx:id="trimestreCol" text="Trimestre" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
