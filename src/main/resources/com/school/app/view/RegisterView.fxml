<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="@style.css" styleClass="login-container" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.app.controller.RegisterController">
    <VBox spacing="15" alignment="CENTER" maxWidth="450" styleClass="login-box">
        <Text text="Créer un compte" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
        
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            
            <Label text="Prénom:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="prenomField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            
            <Label text="Date Naissance:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            
            <Label text="Adresse:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="adresseField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            
            <Label text="Tél. Parent:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            
            <Label text="Utilisateur:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            
            <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            
            <Label text="Niveau:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <ComboBox fx:id="niveauCombo" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="200" promptText="Choisir Niveau"/>
        </GridPane>
        
        <HBox spacing="10" alignment="CENTER">
            <Button text="S'inscrire" onAction="#handleRegister" style="-fx-font-weight: bold;"/>
            <Button text="Retour" onAction="#handleBack" style="-fx-background-color: #7f8c8d;"/>
        </HBox>
        
        <Label fx:id="statusLabel" text=""/>
    </VBox>
</StackPane>
